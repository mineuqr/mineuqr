# MineuQR Connector — EV code signing configuration (release machine only)
# Copy to signing.env and load before sign-release.ps1. Never commit signing.env or PFX files.

# Option A: certificate installed in Windows certificate store (recommended for EV hardware token)
# CONNECTOR_SIGNING_CERT_SHA1=YOUR_CERT_THUMBPRINT

# Option B: PFX file on release machine (path outside repository)
# CONNECTOR_SIGNING_PFX_PATH=C:\secure\certs\mineuqr-connector.pfx
# CONNECTOR_SIGNING_CERT_PASSWORD=

# Timestamp server (required for commercial releases)
CONNECTOR_SIGNING_TIMESTAMP_URL=http://timestamp.digicert.com

# Optional signtool override
# CONNECTOR_SIGNTOOL_PATH=C:\Program Files (x86)\Windows Kits\10\bin\10.0.22621.0\x64\signtool.exe
