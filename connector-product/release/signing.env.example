# MineuQR Connector — Authenticode code signing configuration (release machine / CI)
# Copy to signing.env for local signing. Never commit signing.env or PFX files.

# --- GitHub Actions (recommended production path) ---
# Repository secrets (Settings → Secrets and variables → Actions):
#   CONNECTOR_SIGNING_PFX_BASE64  — base64-encoded code signing PFX (Standard or EV export)
#   CONNECTOR_SIGNING_CERT_PASSWORD — PFX password
# prepare-connector-signing.ps1 materializes the PFX in RUNNER_TEMP before sign-release.ps1 runs.

# --- Release machine: certificate in Windows store (EV hardware token) ---
# CONNECTOR_SIGNING_CERT_SHA1=YOUR_CERT_THUMBPRINT

# --- Release machine: PFX file outside repository ---
# CONNECTOR_SIGNING_PFX_PATH=C:\secure\certs\mineuqr-connector.pfx
# CONNECTOR_SIGNING_CERT_PASSWORD=

# Timestamp server (required — signatures remain valid after certificate expiry)
CONNECTOR_SIGNING_TIMESTAMP_URL=http://timestamp.digicert.com

# Optional signtool override
# CONNECTOR_SIGNTOOL_PATH=C:\Program Files (x86)\Windows Kits\10\bin\10.0.22621.0\x64\signtool.exe
